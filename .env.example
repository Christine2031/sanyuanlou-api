# Kimi (Moonshot AI) — https://platform.moonshot.cn/
KIMI_API_KEY="your_kimi_api_key_here"

# Supabase — shared member database (三元楼 + 半球)
# Dashboard → Settings → API
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"   # ⚠️ 不要暴露到前端！

# Server port (Cloud Run 会自动注入 PORT=8080, 本地开发用 3001)
PORT=3001
